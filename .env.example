# Command Code Provider API (OpenAI-compatible)
# Docs: https://commandcode.ai/docs/provider
# Key page: https://commandcode.ai/settings/keys
COMMAND_CODE_API_KEY=cmd-your-key-here
COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMAND_CODE_MODEL=deepseek/deepseek-v4-flash

# Optional: only needed if you still call OpenAI models directly
# OPENAI_API_KEY=sk-your-key-here

LLM_MODE=online
