{
  "name": "llm-forge",
  "version": "1.0.0",
  "description": "A small learning project for running one LangChain agent in two ways: an online OpenAI model, or a local Qwen model through Ollama. LangSmith tracing is turned on so each run can be inspected.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Girishgktester/llm-forge.git"
  },
  "keywords": [],
