  "bugs": {
    "url": "https://github.com/Girishgktester/llm-forge/issues"
  },
  "homepage": "https://github.com/Girishgktester/llm-forge#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
